<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.edgareldy.springjdbctutorial</groupId>
        <artifactId>spring-jdbc-tutorial</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ws</artifactId>
    <packaging>war</packaging>
    <name>ws</name>
    <description>HTTP layer (Spring MVC, security, payloads), packaged as a WAR for Tomcat 10.1</description>

    <dependencies>
        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>customer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>order</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- Provided by Tomcat 10.1 (Servlet 6.0) at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- Bean Validation, used standalone (no JPA): the implementation and its EL engine -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>com.edgareldy.springjdbctutorial</groupId>
            <artifactId>common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- ws/target/ws.war, as the README says -->
        <finalName>ws</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <!-- No web.xml: WebAppInitializer (WebApplicationInitializer) replaces it -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
